class CircularTimer(QWidget):

    def __init__(self):

        super().__init__()

        self.value = 60

        self.maximum = 60

        self.setMinimumSize(320,320)

    def setValue(self,value):

        self.value = value

        self.update()

    def paintEvent(self,event):

        painter = QPainter(self)

        painter.setRenderHint(QPainter.Antialiasing)

        size = min(self.width(),self.height())-20

        rect = QRectF(

            (self.width()-size)/2,

            (self.height()-size)/2,

            size,

            size

        )

        ###################################

        pen = QPen(QColor(230,230,230),18)

        painter.setPen(pen)

        painter.drawEllipse(rect)

        ###################################

        angle = 360*self.value/self.maximum

        pen = QPen(QColor("#1976D2"),18)

        painter.setPen(pen)

        painter.drawArc(

            rect,

            90*16,

            -angle*16

        )

        ###################################

        painter.setPen(Qt.black)

        painter.setFont(

            QFont(

                "Arial",

                42,

                QFont.Bold

            )

        )

        painter.drawText(

            rect,

            Qt.AlignCenter,

            str(self.value)

        )


