    # Réinitialiser la page
    ###################################################

    def reset_page(self):

        self.ppm = ""

        self.display.setText("")

    ###################################################
    # Validation
    ###################################################

    def validate_ppm(self):

        if self.ppm == "":

            QMessageBox.warning(

                self,

                "PPM",

                "Veuillez saisir le PPM du patient."

            )

            return

        ###############################################

        self.window.patient.ppm = self.ppm

        print("Patient :", self.window.patient.ppm)

