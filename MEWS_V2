            ###########################################################
    # Réinitialiser la page
    ###########################################################

    def reset_page(self):

        self.timer.stop()

        self.running = False

        self.remaining_time = 60

        self.nb_respirations = 0

        self.circular.setValue(60)

        self.counterLabel.setText("Respirations : 0")

        self.startButton.setEnabled(True)

        self.respButton.setEnabled(False)

        self.nextButton.setEnabled(False)


    ###########################################################
    # Commencer la mesure
    ###########################################################

    def start_measure(self):

        self.reset_page()

        self.running = True

        self.startButton.setEnabled(False)

        self.respButton.setEnabled(True)

        self.timer.start(1000)


    ###########################################################
    # Mise à jour du chronomètre
    ###########################################################

    def update_timer(self):

        self.remaining_time -= 1

        self.circular.setValue(self.remaining_time)

        if self.remaining_time <= 0:

            self.timer.stop()

            self.running = False

            self.respButton.setEnabled(False)

            self.nextButton.setEnabled(True)

            self.startButton.setEnabled(True)

            self.window.patient.frequence_respiratoire = self.nb_respirations

            print("Respirations enregistrées :")

            print(self.window.patient.frequence_respiratoire)


    ###########################################################
    # Ajouter une respiration
    ###########################################################

    def add_respiration(self):

        if not self.running:
            return

        self.nb_respirations += 1

        self.counterLabel.setText(

            f"Respirations : {self.nb_respirations}"

        )


    ###########################################################
    # Page suivante
    ###########################################################

    def next_page(self):

        print("========== PATIENT ==========")

        print("PPM :", self.window.patient.ppm)

        print(

            "Respiration :",

            self.window.patient.frequence_respiratoire

        )

        print("=============================")

